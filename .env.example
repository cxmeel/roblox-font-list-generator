# Optional credentials for Roblox web requests. Copy to `.env` and fill in
# whichever you need; `.env` is ignored by git. Real environment variables take
# precedence over this file, so CI can supply the same names as secrets.
#
# Asset delivery has required authentication since April 2025 and throttles
# unauthenticated traffic, which is what a CI runner looks like from outside.

# An Open Cloud API key, used when `--auth` is passed without a value, or
# automatically when this is set. Create one at:
# https://create.roblox.com/dashboard/credentials
ROBLOX_OPEN_CLOUD_API_KEY=

# A `.ROBLOSECURITY` cookie, used by a bare `--auth` in preference to one from a
# local Roblox installation. This is full access to the account it belongs to,
# not a scoped credential, so treat it accordingly and never commit one.
ROBLOSECURITY=
